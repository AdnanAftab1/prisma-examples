    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "^8.15.6",
    "prisma": "7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.8.3"
  },
