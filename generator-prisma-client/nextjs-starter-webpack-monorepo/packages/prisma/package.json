{
  "name": "@nextjs-starter-webpack-monorepo/prisma",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma-examples.git",
    "directory": "generator-prisma-client/nextjs-starter-webpack-monorepo/packages/db"
  },
  "keywords": [
    "prisma",
    "postgres",
    "nextjs",
    "esm",
    "prisma-client",
    "typescript"
  ],
  "author": "Alberto Schiabel <schiabel@prisma.io>",
  "exports": {
    ".": {
      "import": {
        "@prisma/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "./enums": {
      "import": {
        "types": "./dist/enums.d.ts",
        "import": "./dist/enums.js",
        "default": "./dist/enums.js"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf ./src/.generated",
